---
import '../styles/global.css';
import NavBar from '../components/NavBar.astro';
import Footer from '../components/Footer.astro';
import { getLangFromUrl } from '../i18n/utils';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Šećerless — Recipes, Stories & Collaboration',
  description = 'Home recipes, food stories and collaboration — from sugar-free treats to everything else.',
} = Astro.props;

const lang = getLangFromUrl(Astro.url);
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <!--
      Set the theme BEFORE the page paints, so there's no flash of the
      wrong theme. Reads saved preference, falls back to OS preference.
    -->
    <script is:inline>
      (function () {
        const saved = localStorage.getItem('secerless_theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const theme = saved || (prefersDark ? 'secerless-dark' : 'secerless');
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col bg-base-100 text-base-content">
    <NavBar />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />

    <!-- Fixed, top-most layer so toasts are visible even above open modals (DaisyUI modal z-index is 999) -->
    <div
      id="global-toast-root"
      style="position: fixed; top: 1rem; right: 1rem; z-index: 2147483647; display: flex; flex-direction: column; gap: 0.5rem; pointer-events: none; max-width: calc(100vw - 2rem);"
    ></div>

    <script is:inline>
      (() => {
        const root = document.getElementById('global-toast-root');
        if (!root) return;

        const eventName = 'secerless:toast';

        function renderToast(message, type = 'success', duration = 2800) {
          const alertClass =
            type === 'success' ? 'alert-success' : type === 'error' ? 'alert-error' : 'alert-info';
          const toast = document.createElement('div');
          toast.className = `alert ${alertClass} shadow-lg`;
          toast.style.pointerEvents = 'auto';
          const span = document.createElement('span');
          span.textContent = String(message); // textContent avoids HTML injection
          toast.appendChild(span);
          root.appendChild(toast);
          setTimeout(() => {
            toast.remove();
          }, duration);
        }

        window.addEventListener(eventName, (event) => {
          const { message, type, duration } = event.detail || {};
          if (!message) return;
          renderToast(message, type || 'success', duration || 2800);
        });
      })();
    </script>
  </body>
</html>

