---
import '../styles/global.css';
import NavBar from '../components/NavBar.astro';
import Footer from '../components/Footer.astro';
import { getLangFromUrl } from '../i18n/utils';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Šećerless — Recipes, Stories & Collaboration',
  description = 'Home recipes, food stories and collaboration — from sugar-free treats to everything else.',
} = Astro.props;

const lang = getLangFromUrl(Astro.url);
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <!--
      Set the theme BEFORE the page paints, so there's no flash of the
      wrong theme. Reads saved preference, falls back to OS preference.
    -->
    <script is:inline>
      (function () {
        const saved = localStorage.getItem('secerless_theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const theme = saved || (prefersDark ? 'secerless-dark' : 'secerless');
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col bg-base-100 text-base-content font-sans">
    <NavBar />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />

    <!-- Scroll-reveal: adds .is-visible to every .reveal element when it enters the viewport -->
    <script is:inline>
      (() => {
        const els = document.querySelectorAll('.reveal');
        if (!('IntersectionObserver' in window)) {
          els.forEach((el) => el.classList.add('is-visible'));
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
        );
        els.forEach((el) => io.observe(el));
      })();
    </script>

    <div
      id="global-toast-root"
      popover="manual"
      class="toast toast-top toast-end top-[5.5rem] m-0 border-0 bg-transparent p-0 overflow-visible whitespace-normal max-w-[calc(100vw-2rem)] pointer-events-none"
    ></div>

    <script is:inline>
      (() => {
        const root = document.getElementById('global-toast-root');
        if (!root) return;

        const eventName = 'secerless:toast';
        const canPopover = typeof root.showPopover === 'function';

        // (Re)open the popover so it's the newest top-layer item, i.e. above any open modal
        function bringToFront() {
          if (!canPopover) return;
          if (root.matches(':popover-open')) root.hidePopover();
          root.showPopover();
        }

        function renderToast(message, type = 'success', duration = 2800) {
          const alertClass =
            type === 'success' ? 'alert-success' : type === 'error' ? 'alert-error' : 'alert-info';
          const toast = document.createElement('div');
          toast.className = `alert ${alertClass} shadow-lg pointer-events-auto`;
          toast.setAttribute('role', type === 'error' ? 'alert' : 'status');
          const span = document.createElement('span');
          span.textContent = String(message); // textContent avoids HTML injection
          toast.appendChild(span);
          root.appendChild(toast);
          bringToFront();
          setTimeout(() => {
            toast.remove();
            if (canPopover && !root.childElementCount && root.matches(':popover-open')) root.hidePopover();
          }, duration);
        }

        window.addEventListener(eventName, (event) => {
          const { message, type, duration } = event.detail || {};
          if (!message) return;
          renderToast(message, type || 'success', duration || 2800);
        });
      })();
    </script>
  </body>
</html>

