---
import { useTranslations, useTranslatedPath, type Lang } from '../i18n/utils';
import { getRecipes } from '../lib/api';
import FavoriteButton from './FavoriteButton';
import { coverPos, posCss, optimizeImage } from '../lib/image';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const recipes = await getRecipes(lang);

const categories = [
  ...new Map(recipes.filter((r) => r.category).map((r) => [r.category!.slug, r.category!])).values(),
];

const FALLBACK = 'https://images.unsplash.com/photo-1490645935967-10de6ba17061?w=900';
---

<section class="relative -mt-[4.5rem] pt-[4.5rem] bg-blobs">
  <div class="max-w-6xl mx-auto px-4 pt-14 pb-10 text-center reveal">
    <p class="text-xs font-semibold uppercase tracking-[0.25em] text-primary">Šećerless</p>
    <h1 class="mt-3 text-5xl md:text-6xl font-semibold">{t('recipes.title')}</h1>
    <p class="mx-auto mt-4 max-w-2xl text-lg opacity-70">{t('recipes.subtitle')}</p>

    {categories.length > 0 && (
      <div class="mt-8 flex flex-wrap justify-center gap-2" role="group" aria-label="Filter">
        <button type="button" data-filter="all" class="btn btn-sm rounded-full btn-primary">{t('recipes.all')}</button>
        {categories.map((c) => (
          <button type="button" data-filter={c.slug} class="btn btn-sm rounded-full">{c.name}</button>
        ))}
      </div>
    )}
  </div>
</section>

<section class="max-w-6xl mx-auto px-4 pb-8">
  <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-7">
    {recipes.map((r, i) => (
      <article
        class="recipe-card reveal group relative overflow-hidden rounded-[2rem] bg-base-100 border border-base-300 shadow-sm hover:shadow-2xl hover:-translate-y-1.5 transition-all duration-300"
        data-category={r.category?.slug ?? ''}
        style={`--reveal-delay: ${(i % 3) * 80}ms`}
      >
        <a href={translatePath(`/recipes/${r.slug}`)} class="block">
          <figure class="relative aspect-[4/3] overflow-hidden">
            <img
              src={optimizeImage(r.imageUrl, 700) ?? FALLBACK}
              alt={r.title}
              loading="lazy"
              decoding="async"
              class="h-full w-full object-cover transition-[scale] duration-700 group-hover:scale-110"
              style={posCss(coverPos(r))}
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/40 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
            {r.category && (
              <span class="absolute left-4 top-4 rounded-full glass-surface px-3 py-1 text-xs font-semibold">
                {r.category.name}
              </span>
            )}
            {r.videoUrl && (
              <span class="absolute right-4 top-4 flex h-9 w-9 items-center justify-center rounded-full bg-primary text-primary-content text-xs shadow-lg" title="Video">
                ▶
              </span>
            )}
          </figure>
          <div class="p-6">
            <h3 class="text-xl font-semibold leading-snug group-hover:text-primary transition-colors">{r.title}</h3>
            {r.description && <p class="mt-2 text-sm opacity-65 line-clamp-2">{r.description}</p>}
            <span class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-primary">
              {t('recipes.view')}
              <span class="transition-transform group-hover:translate-x-1">→</span>
            </span>
          </div>
        </a>
        <div class="absolute right-4 top-4 rounded-full glass-surface">
          <FavoriteButton recipeId={r.id} lang={lang} client:visible />
        </div>
      </article>
    ))}
  </div>

  {recipes.length === 0 && <p class="text-center opacity-60 py-16">{t('recipes.empty')}</p>}

  <nav
    id="recipe-pagination"
    class="mt-14 flex justify-center"
    aria-label="Pagination"
    data-prev={lang === 'sr' ? '← Prethodna' : '← Previous'}
    data-next={lang === 'sr' ? 'Sledeća →' : 'Next →'}
  ></nav>
</section>


<script>
  const PER_PAGE = 6;
  const chips = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const cards = [...document.querySelectorAll<HTMLElement>('.recipe-card')];
  const nav = document.getElementById('recipe-pagination')!;
  const grid = cards[0]?.parentElement;

  let filter = 'all';
  let page = 1;

  function syncUrl() {
    const url = new URL(window.location.href);
    if (filter === 'all') url.searchParams.delete('category');
    else url.searchParams.set('category', filter);
    if (page === 1) url.searchParams.delete('page');
    else url.searchParams.set('page', String(page));
    history.replaceState(null, '', url);
  }

  function pageButton(label: string, target: number, opts: { active?: boolean; disabled?: boolean } = {}) {
    const b = document.createElement('button');
    b.type = 'button';
    b.className = 'join-item btn btn-sm sm:btn-md' + (opts.active ? ' btn-primary' : '');
    b.textContent = label;
    b.disabled = !!opts.disabled;
    if (opts.active) b.setAttribute('aria-current', 'page');
    b.addEventListener('click', () => {
      page = target;
      render();
      grid?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
    return b;
  }

  function render() {
    chips.forEach((c) => {
      const active = c.dataset.filter === filter;
      c.classList.toggle('btn-primary', active);
      c.setAttribute('aria-pressed', String(active));
    });

    const matching = cards.filter((c) => filter === 'all' || c.dataset.category === filter);
    const pages = Math.max(1, Math.ceil(matching.length / PER_PAGE));
    page = Math.min(Math.max(1, page), pages);
    const from = (page - 1) * PER_PAGE;
    const visible = new Set(matching.slice(from, from + PER_PAGE));

    cards.forEach((card) => {
      const show = visible.has(card);
      card.style.display = show ? '' : 'none';
      if (show) card.classList.add('is-visible');
    });

    // Pagination buttons (daisyUI join)
    nav.replaceChildren();
    if (pages > 1) {
      const join = document.createElement('div');
      join.className = 'join';
      join.append(pageButton(nav.dataset.prev!, page - 1, { disabled: page === 1 }));
      for (let i = 1; i <= pages; i++) {
        // compact: first, last, current ±1, with … gaps
        if (i === 1 || i === pages || Math.abs(i - page) <= 1) {
          join.append(pageButton(String(i), i, { active: i === page }));
        } else if (Math.abs(i - page) === 2) {
          const dots = document.createElement('button');
          dots.type = 'button';
          dots.className = 'join-item btn btn-sm sm:btn-md btn-disabled';
          dots.tabIndex = -1;
          dots.textContent = '…';
          join.append(dots);
        }
      }
      join.append(pageButton(nav.dataset.next!, page + 1, { disabled: page === pages }));
      nav.append(join);
    }
    syncUrl();
  }

  chips.forEach((chip) =>
    chip.addEventListener('click', () => {
      filter = chip.dataset.filter!;
      page = 1;
      render();
    })
  );

  const params = new URLSearchParams(window.location.search);
  const initialCat = params.get('category');
  if (initialCat && [...chips].some((c) => c.dataset.filter === initialCat)) filter = initialCat;
  page = Number(params.get('page')) || 1;
  render();
</script>

