---
import Layout from '../layouts/Layout.astro';

// Placeholder data — Phase 4 will replace this with a real API call to the Express backend.
const topRecipes = [
  { slug: 'garlic-butter-pasta', title: 'Garlic Butter Pasta', image: 'https://images.unsplash.com/photo-1621996346565-e3dbc646d9a9?w=800', excerpt: 'Creamy, garlicky weeknight comfort food.' },
  { slug: 'grandmas-apple-pie', title: "Grandma's Apple Pie", image: 'https://images.unsplash.com/photo-1568571780765-9276ac8b75a2?w=800', excerpt: 'A family classic, baked to golden perfection.' },
  { slug: 'spicy-thai-curry', title: 'Spicy Thai Curry', image: 'https://images.unsplash.com/photo-1455619452474-d2be8b1e70cd?w=800', excerpt: 'Bold, fragrant, and ready in 30 minutes.' },
];
---

<Layout title="Secerless — Recipes & Food Stories">
  <!-- Hero -->
  <section class="hero min-h-[60vh] bg-gradient-to-br from-primary/10 to-secondary/10">
    <div class="hero-content text-center">
      <div class="max-w-2xl">
        <h1 class="text-5xl font-bold mb-4">Cooking, shared. 🍲</h1>
        <p class="py-4 text-lg opacity-80">
          Real recipes from my kitchen to yours — plus stories, tips, and a
          place to ask questions or collaborate.
        </p>
        <a href="/recipes" class="btn btn-primary btn-lg">Browse Recipes</a>
      </div>
    </div>
  </section>

  <!-- Top recipes slider (will become a React island carousel in Phase 8) -->
  <section class="max-w-6xl mx-auto px-4 py-16">
    <h2 class="text-3xl font-bold mb-8 text-center">🔥 Top Recipes</h2>
    <div class="grid md:grid-cols-3 gap-6">
      {topRecipes.map((r) => (
        <a href={`/recipes/${r.slug}`} class="card bg-base-100 shadow-md hover:shadow-xl transition-shadow">
          <figure><img src={r.image} alt={r.title} class="h-48 w-full object-cover" /></figure>
          <div class="card-body">
            <h3 class="card-title">{r.title}</h3>
            <p class="opacity-70">{r.excerpt}</p>
          </div>
        </a>
      ))}
    </div>
    <p class="text-center text-sm opacity-50 mt-6">
      (This will become a proper animated carousel React island in Phase 8 👀)
    </p>
  </section>
</Layout>
