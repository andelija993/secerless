---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Sign Up — Secerless">
  <section class="max-w-md mx-auto px-4 py-16">
    <h1 class="text-3xl font-bold mb-6 text-center">Create Account</h1>
    <form class="flex flex-col gap-4">
      <input type="text" placeholder="Name" class="input input-bordered w-full" required />
      <input type="email" placeholder="Email" class="input input-bordered w-full" required />
      <input type="password" placeholder="Password" class="input input-bordered w-full" required />
      <button type="submit" class="btn btn-primary">Sign Up</button>
    </form>
    <p class="text-center mt-4 text-sm opacity-70">
      Already have an account? <a href="/login" class="link link-primary">Log in</a>
    </p>
  </section>
</Layout>

