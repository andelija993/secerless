---
import Layout from '../layouts/Layout.astro';
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

<Layout title="Sign Up — Šećerless">
  <section class="max-w-md mx-auto px-4 py-16">
    <h1 class="text-3xl font-bold mb-6 text-center">{t('register.title')}</h1>
    <form class="flex flex-col gap-4">
      <input type="text" placeholder={t('register.name')} class="input input-bordered w-full" required />
      <input type="text" placeholder={t('register.surname')} class="input input-bordered w-full" required />
      <input type="email" placeholder={t('register.email')} class="input input-bordered w-full" required />
      <input type="password" placeholder={t('register.password')} class="input input-bordered w-full" required />
      <button type="submit" class="btn btn-primary">{t('register.submit')}</button>
    </form>
    <p class="text-center mt-4 text-sm opacity-70">
      {t('register.haveAccount')} <a href={translatePath('/login')} class="link link-primary">{t('register.login')}</a>
    </p>
  </section>
</Layout>

