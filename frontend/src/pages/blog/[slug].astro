---
import Layout from '../../layouts/Layout.astro';
import { getPosts, getPostBySlug } from '../../lib/api';
import { marked } from 'marked';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const post = await getPostBySlug(slug!);

if (!post) {
  return Astro.redirect('/404');
}

const lang = Astro.currentLocale ?? 'en';
const title = lang === 'sr' ? (post.titleSr?.trim() || post.title) : post.title;
const content = lang === 'sr' ? (post.contentSr?.trim() || post.content) : post.content;
const contentHtml = marked.parse(content);
const authorName = [post.author?.firstName, post.author?.lastName].filter(Boolean).join(' ');
const formattedDate = new Date(post.publishedAt).toLocaleDateString(lang === 'sr' ? 'sr-RS' : 'en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<Layout title={`${title} — Šećerless`}>
  <article class="max-w-3xl mx-auto px-4 py-16 prose max-w-none">
    {post.coverImageUrl && (
      <img
        src={post.coverImageUrl}
        alt={title}
        class="rounded-2xl w-full h-80 object-cover mb-8 not-prose"
      />
    )}
    <h1>{title}</h1>
    <p class="opacity-60 text-sm">
      {authorName && <>By {authorName} · </>}{formattedDate}
    </p>
    <div set:html={contentHtml} />
  </article>
</Layout>

