---
import Layout from '../../layouts/Layout.astro';

const posts = [
  { slug: 'why-i-started-cooking', title: 'Why I Started Cooking', excerpt: 'The story behind this whole project.' },
];
---

<Layout title="Blog — Secerless">
  <section class="max-w-3xl mx-auto px-4 py-16">
    <h1 class="text-4xl font-bold mb-8">Blog</h1>
    <div class="flex flex-col gap-4">
      {posts.map((p) => (
        <a href={`/blog/${p.slug}`} class="card bg-base-100 shadow-md hover:shadow-xl transition-shadow">
          <div class="card-body">
            <h3 class="card-title">{p.title}</h3>
            <p class="opacity-70">{p.excerpt}</p>
          </div>
        </a>
      ))}
    </div>
  </section>
</Layout>

