---
import Layout from '../../layouts/Layout.astro';
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../../i18n/utils';
import LoginForm from '../../components/LoginForm.tsx';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

<Layout title="Prijava — Šećerless">
  <section class="max-w-md mx-auto px-4 py-16">
    <h1 class="text-3xl font-bold mb-6 text-center">{t('login.title')}</h1>
    <LoginForm client:load lang={lang} />
    <p class="text-center mt-4 text-sm opacity-70">
      {t('login.noAccount')} <a href={translatePath('/register')} class="link link-primary">{t('login.signup')}</a>
    </p>
  </section>
</Layout>

