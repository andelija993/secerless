---
import Layout from '../../layouts/Layout.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout title="Pitanja i saradnja — Šećerless">
  <section class="max-w-xl mx-auto px-4 py-16">
    <h1 class="text-4xl font-bold mb-2">{t('contact.title')}</h1>
    <p class="opacity-70 mb-8">
      {t('contact.subtitle')}
    </p>

    <!-- Static form for now — Phase 2/6 will wire this to POST /api/contact -->
    <form class="flex flex-col gap-4">
      <label class="fieldset">
        <span class="fieldset-legend justify-start">{t('contact.name')}</span>
        <input type="text" placeholder={t('contact.namePlaceholder')} class="input w-full" required />
      </label>
      <label class="fieldset">
        <span class="fieldset-legend justify-start">{t('contact.email')}</span>
        <input type="email" placeholder="you@example.com" class="input w-full" required />
      </label>
      <label class="fieldset">
        <span class="fieldset-legend justify-start">{t('contact.message')}</span>
        <textarea class="textarea w-full h-32" placeholder={t('contact.messagePlaceholder')} required></textarea>
      </label>
      <button type="submit" class="btn btn-primary mt-2">{t('contact.submit')}</button>
    </form>
  </section>
</Layout>

