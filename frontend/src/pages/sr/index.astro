---
import Layout from '../../layouts/Layout.astro';
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../../i18n/utils';
import { getRecipes } from '../../lib/api';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

// Real data from the Express/Prisma API (Phase 4) — top 3 most recent recipes.
const allRecipes = await getRecipes();
const topRecipes = allRecipes.slice(0, 3);
---

<Layout title="Šećerless — Recepti i priče o hrani">
  <!-- Hero -->
  <section class="hero min-h-[60vh] bg-gradient-to-br from-primary/10 to-secondary/10">
    <div class="hero-content text-center">
      <div class="max-w-2xl">
        <h1 class="text-5xl font-bold mb-4">{t('home.title')}</h1>
        <p class="py-4 text-lg opacity-80">
          {t('home.subtitle')}
        </p>
        <a href={translatePath('/recipes')} class="btn btn-primary btn-lg">{t('home.cta')}</a>
      </div>
    </div>
  </section>

  <!-- Top recipes slider (will become a React island carousel in Phase 8) -->
  <section class="max-w-6xl mx-auto px-4 py-16">
    <h2 class="text-3xl font-bold mb-8 text-center">{t('home.topRecipes')}</h2>
    <div class="grid md:grid-cols-3 gap-6">
      {topRecipes.map((r) => (
        <a href={translatePath(`/recipes/${r.slug}`)} class="card bg-base-100 shadow-md hover:shadow-xl transition-shadow">
          <figure><img src={r.imageUrl ?? undefined} alt={r.title} class="h-48 w-full object-cover" /></figure>
          <div class="card-body">
            <h3 class="card-title">{r.title}</h3>
            <p class="opacity-70">{r.description}</p>
          </div>
        </a>
      ))}
    </div>
    {topRecipes.length === 0 && (
      <p class="text-center opacity-60">
        Još nema recepata — dodajte ih preko API-ja ili admin panela (Faza 5)!
      </p>
    )}
    <p class="text-center text-sm opacity-50 mt-6">
      {t('home.sliderNote')}
    </p>
  </section>
</Layout>

