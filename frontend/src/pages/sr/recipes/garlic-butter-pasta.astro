---
import Layout from '../../../layouts/Layout.astro';
import { getLangFromUrl, useTranslations } from '../../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Placeholder detail page. In Phase 6 this becomes a dynamic [slug].astro
// route that fetches real data from GET /api/recipes/:slug
---

<Layout title="Garlic Butter Pasta — Secerless">
  <article class="max-w-3xl mx-auto px-4 py-16">
    <h1 class="text-4xl font-bold mb-4">Garlic Butter Pasta</h1>
    <img
      src="https://images.unsplash.com/photo-1621996346565-e3dbc646d9a9?w=1200"
      alt="Garlic Butter Pasta"
      class="rounded-2xl w-full h-80 object-cover mb-8"
    />

    <button class="btn btn-outline btn-primary mb-8">{t('recipes.save')}</button>

    <h2 class="text-2xl font-bold mb-3">{t('recipes.ingredients')}</h2>
    <ul class="list-disc list-inside mb-8 opacity-80">
      <li>400g spaghetti</li>
      <li>6 cloves garlic, minced</li>
      <li>60g butter</li>
      <li>Parmesan, parsley, chili flakes</li>
    </ul>

    <h2 class="text-2xl font-bold mb-3">{t('recipes.steps')}</h2>
    <ol class="list-decimal list-inside space-y-2 opacity-80">
      <li>Boil pasta until al dente.</li>
      <li>Melt butter, sauté garlic until fragrant.</li>
      <li>Toss pasta in the garlic butter with a splash of pasta water.</li>
      <li>Top with parmesan, parsley, and chili flakes.</li>
    </ol>
  </article>
</Layout>

