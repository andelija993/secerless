---
import Layout from '../../../layouts/Layout.astro';
import RecipeDetailView from '../../../components/RecipeDetailView.astro';
import { getRecipes, getRecipeBySlug } from '../../../lib/api';
export async function getStaticPaths() {
  const recipes = await getRecipes();
  return recipes.map((r) => ({ params: { slug: r.slug } }));
}
const recipe = await getRecipeBySlug(Astro.params.slug!);
if (!recipe) return Astro.redirect('/sr/recipes');
---
<Layout title={`${recipe.title} — Šećerless`}>
  <RecipeDetailView recipe={recipe} lang="sr" />
</Layout>
