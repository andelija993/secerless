---
import Layout from '../../../layouts/Layout.astro';
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../../../i18n/utils';
import { getPosts } from '../../../lib/api';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const posts = await getPosts();

function excerpt(content: string, length = 140) {
  const plain = content.replace(/[#*_`>\-]/g, '').trim();
  return plain.length > length ? plain.slice(0, length) + '…' : plain;
}
---

<Layout title="Blog — Šećerless">
  <section class="max-w-3xl mx-auto px-4 py-16">
    <h1 class="text-4xl font-bold mb-8">{t('blog.title')}</h1>
    <div class="flex flex-col gap-4">
      {posts.map((p) => (
        <a href={translatePath(`/blog/${p.slug}`)} class="card bg-base-100 shadow-md hover:shadow-xl transition-shadow">
          <div class="card-body">
            <h3 class="card-title">{p.title}</h3>
            <p class="opacity-70">{excerpt(p.content)}</p>
          </div>
        </a>
      ))}
    </div>
    {posts.length === 0 && (
      <p class="text-center opacity-60">Još nema objava — svratite uskoro!</p>
    )}
  </section>
</Layout>

