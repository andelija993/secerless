---
import Layout from '../../layouts/Layout.astro';
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../../i18n/utils';
import { getRecipes } from '../../lib/api';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const recipes = await getRecipes();
---

<Layout title="Recipes — Šećerless">
  <section class="max-w-6xl mx-auto px-4 py-16">
    <h1 class="text-4xl font-bold mb-8">{t('recipes.title')}</h1>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {recipes.map((r) => (
        <a href={translatePath(`/recipes/${r.slug}`)} class="card bg-base-100 shadow-md hover:shadow-xl transition-shadow">
          <figure><img src={r.imageUrl ?? undefined} alt={r.title} class="h-44 w-full object-cover" /></figure>
          <div class="card-body">
            {r.category && <span class="badge badge-secondary badge-sm">{r.category.name}</span>}
            <h3 class="card-title">{r.title}</h3>
          </div>
        </a>
      ))}
    </div>
    {recipes.length === 0 && (
      <p class="text-center opacity-60">No recipes yet — check back soon!</p>
    )}
  </section>
</Layout>

