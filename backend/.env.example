# Server
PORT=4000
FRONTEND_URL=http://localhost:4321

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/secerless?schema=public"

# Auth
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Admin account created by `npm run db:seed` (a random password is generated and printed if empty)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Cloudinary (image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Contact form email (Gmail: use an App Password)
CONTACT_TO=you@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Production only: Netlify build hook URL. Admin content changes trigger a site rebuild (debounced 60 s)
NETLIFY_BUILD_HOOK=

